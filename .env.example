# Kalshi API Configuration
KALSHI_API_KEY=your_kalshi_api_key_here
KALSHI_PRIVATE_KEY_PATH=path/to/your/private_key.pem
KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2
KALSHI_WS_BASE=wss://api.elections.kalshi.com/trade-api/ws/v2

# Optional: Polymarket Configuration
POLYMARKET_API_KEY=your_polymarket_api_key_here
POLYMARKET_PRIVATE_KEY=your_polymarket_private_key_here

# Risk Management
MAX_POSITION_SIZE=1000
MAX_DAILY_LOSS=500
KILL_SWITCH_LOSS=1000

# Strategy Configuration
ARB_MIN_SPREAD=0.02
VALUE_MODEL_THRESHOLD=0.05

# Logging
LOG_LEVEL=INFO
